10. Randomization
    $urandom()     -> 32-bit unsigned random integer
    $urandom_range -> $urandom_range(0, 15); // random number between 0 and 15
    rand           -> random variable
    randc          -> cyclic random variable
    randomize()    -> run constraint solver
    constraint     -> legal values/rules
    inside         -> value belongs to set/range
    pre_randomize  -> automatic callback before solving
    post_randomize -> automatic callback after solving
    dist           -> weighted probabilities
    :=             -> weight per value
    :/             -> weight spread across range

11. CMD
    1. verilator --lint-only -Wall rtl/*.sv  (without Wall normal not strict)
    2. verilator --lint-only -Wall -Wno-UNUSEDSIGNAL rtl/*.sv - unsed signals
    3. verilator --lint-only -Wall -Wno-UNUSEDSIGNAL -Wno-UNUSED rtl/*.sv - unused ports
    4. verilator -Wall --lint-only rtl/*.sv - to see all warnings
    5. verilator --binary ..rtl/lfsr.sv ..rtl/crc.sv ..rtl/frame_encoder.sv ..sim/frame_encoder/tb.sv
    6. ./obj_dir/Vtb - to run 
    7. nl -ba rtl/frame_encoder.sv | sed -n '135,165p' - to show lines
    8. verilator --binary --timing --trace --top-module frame_enc_tb rtl/lfsr.sv rtl/frame_encoder.sv rtl/crc.sv sim/frame_encoder/tb.sv
    9. verilator --binary --trace --timing --top-module top sim/frame_encoder/package.sv sim/frame_encoder/interface.sv sim/frame_encoder/logger.sv sim/frame_encoder/transaction.sv sim/frame_encoder/generator.sv sim/frame_encoder/driver.sv sim/frame_encoder/monitor.sv sim/frame_encoder/scoreboard.sv sim/frame_encoder/environment.sv rtl/lfsr.sv rtl/crc.sv rtl/frame_encoder.sv sim/frame_encoder/top.sv 
    10.  ~/verilator/bin/verilator --binary .... [FOR new version 5.046]
    
